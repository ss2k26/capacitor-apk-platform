/**
 * GENERATED by "platform build" from apps/<name>/app.config.json - do not edit by hand,
 * the file is rewritten on every build.
 *
 * Adds to the stock Capacitor activity:
 *  - self-signed HTTPS support, limited to the configured hosts and (optionally) a pinned
 *    SHA-256 certificate fingerprint
 *  - a local "offline / server unreachable" page with a retry button
 *  - optional FLAG_SECURE and keep-screen-on
 */
public class MainActivity extends BridgeActivity{{IMPLEMENTS}} {
{{EXTRA_MEMBERS}}

    private static final boolean ALLOW_SELF_SIGNED = {{ALLOW_SELF_SIGNED}};
    private static final String[] TRUSTED_HOSTS = {{TRUSTED_HOSTS}};
    private static final String[] PINNED_SHA256 = {{PINNED_SHA256}};
    private static final boolean OFFLINE_PAGE = {{OFFLINE_PAGE}};
    private static final boolean SECURE_WINDOW = {{SECURE_WINDOW}};
    private static final boolean KEEP_SCREEN_ON = {{KEEP_SCREEN_ON}};

    @Override
    public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        if (SECURE_WINDOW) {
            getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        }
        if (KEEP_SCREEN_ON) {
            getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        }

        Bridge b = getBridge();
        if (b != null && b.getWebView() != null) {
            b.getWebView().setWebViewClient(new PlatformWebViewClient(b));
        }
    }

    private static class PlatformWebViewClient extends BridgeWebViewClient {

        PlatformWebViewClient(Bridge bridge) {
            super(bridge);
        }

        @Override
        public void onReceivedSslError(WebView view, SslErrorHandler handler, SslError error) {
            if (isTrusted(error)) {
                handler.proceed();
            } else {
                handler.cancel();
            }
        }

        @Override
        public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
            if (OFFLINE_PAGE && request != null && request.isForMainFrame()) {
                String target = Uri.encode(request.getUrl().toString());
                String reason = Uri.encode(String.valueOf(error.getDescription()));
                view.loadUrl("file:///android_asset/public/offline.html?u=" + target + "&r=" + reason);
                return;
            }
            super.onReceivedError(view, request, error);
        }

        private boolean isTrusted(SslError error) {
            if (!ALLOW_SELF_SIGNED || error == null) return false;

            String host = null;
            try {
                host = Uri.parse(error.getUrl()).getHost();
            } catch (Exception ignored) { }
            if (host == null) return false;

            boolean hostOk = false;
            for (String h : TRUSTED_HOSTS) {
                if (h.equalsIgnoreCase(host)) { hostOk = true; break; }
            }
            if (!hostOk) return false;

            if (PINNED_SHA256.length == 0) return true;

            try {
                SslCertificate cert = error.getCertificate();
                if (cert == null) return false;
                byte[] der = null;
                if (android.os.Build.VERSION.SDK_INT >= 29) {
                    java.security.cert.X509Certificate x = cert.getX509Certificate();
                    if (x != null) der = x.getEncoded();
                } else {
                    der = SslCertificate.saveState(cert).getByteArray("x509-certificate");
                }
                if (der == null) return false;
                byte[] digest = MessageDigest.getInstance("SHA-256").digest(der);
                StringBuilder sb = new StringBuilder();
                for (byte x : digest) sb.append(String.format("%02x", x));
                String fp = sb.toString();
                for (String pin : PINNED_SHA256) {
                    if (pin.equalsIgnoreCase(fp)) return true;
                }
            } catch (Exception ignored) { }
            return false;
        }
    }
}
